{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Anid4u2c/schemas/main/json/architecture-technology.schema.json",
  "title": "Repository-declared architecture technology",
  "type": "object",
  "required": ["name", "role"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "sourceFiles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}

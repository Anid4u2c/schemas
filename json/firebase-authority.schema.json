{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Anid4u2c/schemas/main/json/firebase-authority.schema.json",
  "title": "Repository-derived Firebase authority",
  "type": "object",
  "required": ["derivedFrom", "projectId"],
  "properties": {
    "derivedFrom": {
      "oneOf": [
        { "enum": [".firebaserc", "not_applicable"] },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      ]
    },
    "projectId": { "anyOf": [{ "type": "string", "minLength": 1 }, { "const": "not_applicable" }] },
    "products": { "$ref": "firebase-products.schema.json" }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Anid4u2c/schemas/main/json/architecture-layer.schema.json",
  "title": "Repository-declared architecture layer",
  "type": "object",
  "required": ["name", "purpose", "technologies"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "technologies": { "type": "array", "minItems": 1, "items": { "$ref": "architecture-technology.schema.json" } },
    "sourceFiles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  },
  "additionalProperties": false
}

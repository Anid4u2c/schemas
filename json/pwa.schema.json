{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Anid4u2c/schemas/main/json/pwa.schema.json",
  "title": "PWA configuration authority",
  "type": "object",
  "required": ["schemaVersion", "current", "major", "minor", "status", "readme"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "current": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "major": { "type": "integer", "minimum": 0 },
    "minor": { "type": "integer", "minimum": 0 },
    "status": {
      "enum": ["planned", "in_progress", "adopted", "not_applicable"]
    },
    "readme": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["showcase", "guided", "reference", "custom", "not_applicable"] }
      },
      "additionalProperties": true
    },
    "firestore": {
      "type": "object",
      "required": ["projectId", "database", "currentDocument", "versionCollection"],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "database": { "const": "(default)" },
        "currentDocument": { "const": "config/pwa" },
        "versionCollection": { "const": "config/pwa/version" }
      },
      "additionalProperties": true
    },
    "sync": {
      "type": "object",
      "required": ["source", "workflow"],
      "properties": {
        "source": { "const": "repository" },
        "workflow": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": { "properties": { "current": { "pattern": "^1\\.0$" } } },
      "then": {
        "properties": {
          "major": { "const": 1 },
          "minor": { "const": 0 }
        }
      }
    }
  ],
  "additionalProperties": true
}

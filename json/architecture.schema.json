{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Anid4u2c/schemas/main/json/architecture.schema.json",
  "title": "Repository-derived application architecture",
  "type": "object",
  "required": ["derivedFrom", "layers"],
  "properties": {
    "derivedFrom": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "layers": { "type": "array", "minItems": 1, "items": { "$ref": "architecture-layer.schema.json" } },
    "flows": { "type": "array", "items": { "$ref": "architecture-flow.schema.json" } },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}

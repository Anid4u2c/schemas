{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Anid4u2c/schemas/main/json/service-account.schema.json",
  "title": "Service account inventory entry",
  "type": "object",
  "required": ["principal", "purpose", "keyPosture", "evidence"],
  "properties": {
    "principal": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.iam\\.gserviceaccount\\.com$" },
    "purpose": { "type": "string", "minLength": 1 },
    "keyPosture": { "enum": ["no_user_managed_keys", "user_managed_key_present", "not_assessed"] },
    "evidence": { "$ref": "evidence.schema.json" }
  },
  "additionalProperties": false
}
